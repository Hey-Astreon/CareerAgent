datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

enum ApplicationStatus {
  DISCOVERED
  SHORTLISTED
  APPLIED
  SCREENING
  TECHNICAL_ROUND
  OFFER
  REJECTED
  QUIET
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED_DIRECT_ATS
  VERIFIED_AGGREGATOR
  COMMUNITY_SUBMITTED
  FLAGGED_STALE
}

enum SyncStatus {
  HEALTHY
  DEGRADED
  FAILING
  DISABLED
}

enum PlatformSource {
  LINKEDIN
  WELLFOUND
  YC_JOBS
  NAUKRI
  GREENHOUSE
  LEVER
  ASHBY
  MICRO1
  ALIGNER
  DIRECT_PORTAL
  HIMALAYAS
  REMOTIVE
  HN_HIRING
  WORKABLE
  SMARTRECRUITERS
  RECRUITEE
}

model ProviderSyncState {
  id                   String     @id @default(uuid())
  providerKey          String     @unique
  status               SyncStatus @default(HEALTHY)
  lastSyncAttemptAt    DateTime?
  lastSuccessfulSyncAt DateTime?
  lastFailedSyncAt     DateTime?
  consecutiveFailures  Int        @default(0)
  lastError            String?
  totalJobsSeen        Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  occurrences JobOccurrence[]

  @@map("provider_sync_states")
}

model Profile {
  id               String              @id @default(uuid())
  slug             String              @unique
  fullName         String
  title            String
  email            String
  phone            String?
  location         String
  portfolioUrl     String?
  githubUrl        String?
  linkedinUrl      String?
  masterResumePath String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  projects     Project[]
  virtualExps  VirtualExperience[]
  applications Application[]
  matchScores  MatchScore[]

  @@map("profiles")
}

model Project {
  id           String   @id @default(uuid())
  profileId    String
  title        String
  techStack    String
  liveDemoUrl  String?
  githubUrl    String?
  architecture String
  bulletPoints String
  createdAt    DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("projects")
}

model VirtualExperience {
  id           String   @id @default(uuid())
  profileId    String
  company      String
  roleTitle    String
  period       String
  problemScope String
  actionTaken  String
  outcome      String
  createdAt    DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("virtual_experiences")
}

model JobPosting {
  id              String         @id @default(uuid())
  urlHash         String         @unique
  url             String
  company         String
  title           String
  category        String         @default("Software Developer")
  jobType         String         @default("Remote Full-Time")
  experienceLevel String         @default("0-3 Years (Entry/Junior)")
  platform        PlatformSource
  location        String
  isRemote        Boolean        @default(true)
  applicantCount  Int?
  postedAt        DateTime
  rawDescription  String
  lastSeenAt      DateTime       @default(now())
  isExpired       Boolean        @default(false)
  hasFullText     Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  matchScores  MatchScore[]
  applications Application[]

  @@index([postedAt])
  @@index([isRemote])
  @@index([category])
  @@index([lastSeenAt])
  @@index([isExpired])
  @@map("job_postings")
}

model Opportunity {
  id              String   @id @default(uuid())
  company         String
  companySlug     String
  title           String
  category        String   @default("Software Developer")
  jobType         String   @default("Remote Full-Time")
  experienceLevel String   @default("0-3 Years (Entry/Junior)")
  location        String
  isRemote        Boolean  @default(true)
  remoteRegion    String?
  canonicalAppUrl String
  technologies    String   @default("[]")
  rawDescription  String
  hasFullText     Boolean  @default(true)

  postedAt        DateTime
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  isExpired       Boolean  @default(false)
  expiredAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  occurrences  JobOccurrence[]
  matchScores  MatchScore[]
  applications Application[]

  @@index([postedAt])
  @@index([isRemote])
  @@index([category])
  @@index([isExpired])
  @@index([companySlug, title])
  @@map("opportunities")
}

model JobOccurrence {
  id                 String             @id @default(uuid())
  opportunityId     String
  providerKey        String
  sourceJobId        String?
  discoveryUrl       String
  applicationUrl     String
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rawLocation        String?
  postedAt           DateTime
  firstSeenAt        DateTime           @default(now())
  lastSeenAt         DateTime           @default(now())
  metadata           String?

  opportunity  Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  providerSync ProviderSyncState @relation(fields: [providerKey], references: [providerKey], onDelete: Cascade)

  @@unique([providerKey, sourceJobId])
  @@index([opportunityId])
  @@index([providerKey])
  @@map("job_occurrences")
}

model MatchScore {
  id            String   @id @default(uuid())
  profileId     String
  jobPostingId  String?
  opportunityId String?
  score         Int
  hardSkills    String
  missingSkills String
  reasoning     String
  evaluatedAt   DateTime @default(now())

  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobPosting  JobPosting?  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobPostingId])
  @@unique([profileId, opportunityId])
  @@map("match_scores")
}

model Application {
  id                     String            @id @default(uuid())
  profileId              String
  jobPostingId           String?
  opportunityId         String?
  status                 ApplicationStatus @default(DISCOVERED)
  tailoredCvPath         String?
  tailoredCoverLetter    String?
  atsExtractabilityScore Int?
  appliedAt              DateTime?
  lastContactAt          DateTime?
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobPosting  JobPosting?  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@map("applications")
}
